{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "title": "Sui Suto",
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "deep-ink",
          "color": "#111111",
          "name": "Deep Ink"
        },
        {
          "slug": "warm-ivory",
          "color": "#FBF9F5",
          "name": "Warm Ivory"
        },
        {
          "slug": "soft-white",
          "color": "#FFFFFF",
          "name": "Soft White"
        },
        {
          "slug": "charcoal",
          "color": "#2B2B2B",
          "name": "Charcoal"
        },
        {
          "slug": "deep-indigo",
          "color": "#1E2430",
          "name": "Deep Indigo"
        },
        {
          "slug": "muted-clay",
          "color": "#A87C6D",
          "name": "Muted Clay"
        },
        {
          "slug": "antique-brass",
          "color": "#C5A059",
          "name": "Antique Brass"
        }
      ],
      "gradients": [],
      "duotone": []
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        { "name": "3XS", "size": "0.25rem", "slug": "10" },
        { "name": "2XS", "size": "0.5rem", "slug": "20" },
        { "name": "XS", "size": "1rem", "slug": "30" },
        { "name": "S", "size": "1.5rem", "slug": "40" },
        { "name": "M", "size": "2.5rem", "slug": "50" },
        { "name": "L", "size": "4rem", "slug": "60" },
        { "name": "XL", "size": "6rem", "slug": "70" },
        { "name": "2XL", "size": "9rem", "slug": "80" }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "'Cormorant Garamond', Georgia, serif",
          "name": "Serif Display",
          "slug": "serif",
          "fontFace": [
            {
              "fontFamily": "Cormorant Garamond",
              "fontStyle": "normal",
              "fontWeight": "400 600 700",
              "src": ["https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"]
            }
          ]
        },
        {
          "fontFamily": "'Plus Jakarta Sans', -apple-system, sans-serif",
          "name": "Sans Body",
          "slug": "body",
          "fontFace": [
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "normal",
              "fontWeight": "300 400 500 600",
              "src": ["https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.8rem",
          "slug": "small"
        },
        {
          "name": "Medium / Body",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.35rem",
          "slug": "large"
        },
        {
          "name": "Extra Large (H3)",
          "size": "clamp(1.75rem, 2.5vw, 2.25rem)",
          "slug": "x-large"
        },
        {
          "name": "Heading (H2)",
          "size": "clamp(2.25rem, 3.5vw, 3.25rem)",
          "slug": "xx-large"
        },
        {
          "name": "Display (H1)",
          "size": "clamp(3rem, 5vw, 4.75rem)",
          "slug": "display"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--warm-ivory)",
      "text": "var(--wp--preset--color--deep-ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--display)",
          "lineHeight": "1.1",
          "fontWeight": "500",
          "letterSpacing": "-0.01em"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.2",
          "fontWeight": "500",
          "letterSpacing": "0em"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.3",
          "fontWeight": "500"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--deep-ink)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--muted-clay)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--deep-ink)",
          "text": "var(--wp--preset--color--warm-ivory)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "0.78rem",
          "fontWeight": "600",
          "letterSpacing": "0.18em"
        },
        "border": {
          "radius": "0px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--charcoal)",
            "text": "var(--wp--preset--color--warm-ivory)"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "1.6rem",
          "fontWeight": "600",
          "letterSpacing": "0.25em"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "0.78rem",
          "letterSpacing": "0.18em"
        }
      }
    }
  }
}
